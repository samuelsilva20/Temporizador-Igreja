{
  "name": "temporizador",
  "version": "1.0.0",
  "description": "Temporizador",
  "main": "main.js",
  "author": "Samuel Silva",
  "license": "ISC",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win zip"
  },

  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },

"build": {
  "appId": "pt.igreja.temporizador",
  "productName": "Temporizador Igreja",

  "directories": {
    "output": "dist"
  },

  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "assets/**/*",
    "src/**/*",
    "!src/temporizador-core.js"
  ],

  "win": {
    "target": "zip",
    "icon": "assets/icon.ico"
  }
}
}